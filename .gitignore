# Root Gitignore

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw*
.antigravitycli/

# PM2
.pm2/

# Build directories
build/
dist/
coverage/

# Temporary files
*.tmp
*.temp
